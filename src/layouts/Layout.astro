---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Intermedios Gráfica | Cartelería, Impresiones e Indumentaria en San Luis",
  description = "Especialistas en gráfica, cartelería e indumentaria en San Luis: letreros, letras corpóreas, lonas, vinilo impreso, iluminados, estampado DTF y sublimación. Más de 10 años de trayectoria.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://intermediosgrafica.com.ar");
const ogImageURL = new URL("/favicon.svg", "https://intermediosgrafica.com.ar");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Intermedios Gráfica",
  description: "Empresa especializada en gráfica, cartelería e indumentaria. Diseño, impresión, fabricación e instalación de cartelería y prendas.",
  url: "https://intermediosgrafica.com.ar",
  telephone: "+54-2634-47-6887",
  address: {
    "@type": "PostalAddress",
    addressRegion: "San Luis",
    addressCountry: "AR",
  },
  areaServed: {
    "@type": "City",
    name: "San Luis",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de Gráfica y Cartelería",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Diseño Gráfico" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Impresiones" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Cartelería" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Letras Corpóreas" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Lonas y Vinilos" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Carteles Iluminados" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Estampado DTF" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Sublimación" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Indumentaria" } },
    ],
  },
  sameAs: [
    "https://www.instagram.com/zip.graphic/",
    "https://www.facebook.com/graficazip/",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Intermedios Gráfica" />
    <title>{title}</title>

    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Intermedios Gráfica" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body class="bg-ink text-white font-body antialiased overflow-x-hidden">
    <!-- lomo vertical: el "spine" de la ficha de producción -->
    <div class="hidden lg:flex fixed left-0 top-0 h-full w-14 flex-col items-center justify-between py-10 z-40 border-r border-line">
      <span class="w-px flex-1 bg-line"></span>
      <span class="spine font-mono text-[10px] tracking-[0.35em] text-smoke-dim select-none">
        INTERMEDIOS GRÁFICA
      </span>
      <span class="w-1.5 h-1.5 bg-brand-red"></span>
    </div>

    <div class="lg:pl-14">
      <slot />
    </div>

    <script>
      // Scroll reveal
      const revealEls = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
      );
      revealEls.forEach((el) => io.observe(el));

      // Smooth scroll para anchors internos
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", (e) => {
          const href = anchor.getAttribute("href");
          if (!href || href === "#") return;
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        });
      });
    </script>
  </body>
</html>