---
const base = "/trabajos/";
const clients = [
  {
    name: "3D",
    summary: "Letras y piezas corpóreas con volumen.",
    photos: ["3d_1.JPEG", "3d_2.JPEG", "3d_3.JPEG", "3d_4.JPEG"],
  },
  {
    name: "Acrílico",
    summary: "Carteles y piezas en acrílico cortado.",
    photos: ["Acrilico_1.jpg", "Acrilico_2.jpg", "Acrilico_3.jpg"],
  },
  {
    name: "Chapa",
    summary: "Carteles en chapa para exterior.",
    photos: ["Chapa_1.JPEG", "Chapa_2.JPEG", "Chapa_3.JPEG", "Chapa_4.JPEG"],
  },
  {
    name: "Corpórea",
    summary: "Letras corpóreas para fachadas e interiores.",
    photos: ["Corporea_1.JPEG", "Corporea_2.jpg", "Corporea_3.jpg", "Corporea_4.jpg"],
  },
  {
    name: "Gigantografía",
    summary: "Impresiones de gran formato.",
    photos: ["Gigantografia_1.JPEG", "Gigantografia_2.jpg", "Gigantografia_3.jpg", "Gigantografia_4.jpg"],
  },
  {
    name: "Gráfica general",
    summary: "Folletería, tarjetas y piezas impresas.",
    photos: ["Grafica_general_1.jpg", "Grafica_general_2.jpg", "Grafica_general_3.jpg", "Grafica_general_4.jpg"],
  },
  {
    name: "Indumentaria",
    summary: "Estampado y personalización de prendas.",
    photos: ["Indumentaria_1.jpg", "Indumentaria_2.jpg", "Indumentaria_3.jpg", "Indumentaria_4.jpg"],
  },
  {
    name: "Neón",
    summary: "Carteles de neón LED a medida.",
    photos: ["Neon_1.Jpg", "Neon_2.jpg", "Neon_3.jpg", "Neon_4.jpg"],
  },
  {
    name: "Pastilla",
    summary: "Pastillas y logos para fachadas.",
    photos: ["Pastilla_1.JPEG", "Pastilla_2.jpg", "Pastilla_3.jpg", "Pastilla_4.JPEG"],
  },
  {
    name: "Ploteo",
    summary: "Ploteo de vidrieras y vehículos.",
    photos: ["Ploteo_1.jpg", "Ploteo_2.jpg", "Ploteo_3.jpg", "Ploteo_4.jpg"],
  },
  {
    name: "Stickers",
    summary: "Stickers y etiquetas troqueladas.",
    photos: ["Stickers_1.jpg", "Stickers_2.jpg", "Stickers_3.jpg", "Stickers_4.jpg"],
  },
].map((c) => ({ ...c, photos: c.photos.map((p) => base + p) }));
---

<section id="clientes" class="relative py-16 border-t border-line overflow-hidden">
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 py-12 border-y"
    style="border-image: repeating-linear-gradient(90deg, var(--color-line) 0 6px, transparent 6px 12px) 1;"
  >
    <p class="eyebrow text-center mb-10">Confían en nosotros</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {clients.map((client, ci) => (
        <div
          class="group overflow-hidden bg-surface border border-line shadow-[0_20px_50px_-20px_rgba(0,0,0,0.6)] transition-colors duration-300 hover:border-brand-red"
          data-reveal={ci % 2 === 0 ? "left" : "right"}
        >
          <button
            type="button"
            class="client-photo-btn relative w-full aspect-4/3 overflow-hidden block cursor-pointer"
            data-client-index={ci}
            aria-label={`Ver fotos de ${client.name} en grande`}
          >
            {client.photos.map((src, pi) => (
              <img
                src={src}
                alt={`${client.name} - foto ${pi + 1}`}
                class="client-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-out"
                style={`opacity: ${pi === 0 ? 1 : 0};`}
                loading={pi === 0 ? "eager" : "lazy"}
              />
            ))}
          </button>
          <div class="p-6 text-center">
            <p class="font-display text-2xl md:text-3xl tracking-wide text-white">
              {client.name}
            </p>
            <p class="font-mono text-sm text-smoke-dim mt-2 leading-snug">
              {client.summary}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Lightbox -->
    <div
      id="client-lightbox"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/95 backdrop-blur px-4"
    >
      <button
        id="lightbox-close"
        type="button"
        aria-label="Cerrar"
        class="absolute top-6 right-6 text-white/70 hover:text-white text-3xl leading-none"
      >
        ✕
      </button>

      <button
        id="lightbox-prev"
        type="button"
        aria-label="Foto anterior"
        class="absolute left-2 sm:left-3 md:left-8 w-9 h-9 sm:w-11 sm:h-11 md:w-14 md:h-14 flex items-center justify-center border border-line text-white/80 hover:text-white hover:border-brand-red transition-colors duration-300"
      >
        &#10094;
      </button>

      <div class="max-w-3xl w-full">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="w-full max-h-[70vh] object-contain border border-line"
        />
        <p id="lightbox-name" class="font-display text-xl md:text-2xl text-white text-center mt-4"></p>
        <p id="lightbox-summary" class="font-mono text-sm text-smoke-dim text-center mt-1"></p>
        <p id="lightbox-counter" class="font-mono text-xs text-smoke-dim text-center mt-2"></p>
      </div>

      <button
        id="lightbox-next"
        type="button"
        aria-label="Foto siguiente"
        class="absolute right-2 sm:right-3 md:right-8 w-9 h-9 sm:w-11 sm:h-11 md:w-14 md:h-14 flex items-center justify-center border border-line text-white/80 hover:text-white hover:border-brand-red transition-colors duration-300"
      >
        &#10095;
      </button>
    </div>
  </div>
</section>

<script define:vars={{ clients }}>
  // --- Rotación automática de las 4 fotos en cada tarjeta (cada 2s) ---
  document.querySelectorAll(".client-photo-btn").forEach((btn) => {
    const slides = btn.querySelectorAll(".client-slide");
    let current = 0;
    setInterval(() => {
      const next = (current + 1) % slides.length;
      slides[current].style.opacity = "0";
      slides[next].style.opacity = "1";
      current = next;
    }, 2000);
  });

  // --- Lightbox: navega entre las 4 fotos del cliente tocado ---
  const lightbox = document.getElementById("client-lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxName = document.getElementById("lightbox-name");
  const lightboxSummary = document.getElementById("lightbox-summary");
  const lightboxCounter = document.getElementById("lightbox-counter");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");
  const closeBtn = document.getElementById("lightbox-close");

  let clientIndex = 0;
  let photoIndex = 0;

  const render = () => {
    const client = clients[clientIndex];
    lightboxImg.src = client.photos[photoIndex];
    lightboxImg.alt = `${client.name} - foto ${photoIndex + 1}`;
    lightboxName.textContent = client.name;
    lightboxSummary.textContent = client.summary;
    lightboxCounter.textContent = `${photoIndex + 1} / ${client.photos.length}`;
  };

  const open = (ci) => {
    clientIndex = ci;
    photoIndex = 0;
    render();
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
  };

  const close = () => {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
  };

  document.querySelectorAll(".client-photo-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      open(Number(btn.dataset.clientIndex));
    });
  });

  prevBtn?.addEventListener("click", () => {
    const total = clients[clientIndex].photos.length;
    photoIndex = (photoIndex - 1 + total) % total;
    render();
  });

  nextBtn?.addEventListener("click", () => {
    const total = clients[clientIndex].photos.length;
    photoIndex = (photoIndex + 1) % total;
    render();
  });

  closeBtn?.addEventListener("click", close);
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener("keydown", (e) => {
    if (lightbox?.classList.contains("hidden")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") prevBtn?.click();
    if (e.key === "ArrowRight") nextBtn?.click();
  });
</script>  