---
const links = [
  { href: "#inicio", label: "Inicio" },
  { href: "#servicios", label: "Servicios" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#clientes", label: "Clientes" },
  { href: "#contacto", label: "Contacto" },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 lg:left-14 z-30 transition-[background-color,border-color,backdrop-filter] duration-300 border-b border-transparent">
  <div class="max-w-6xl mx-auto px-6 lg:px-10 flex items-center justify-between h-20 transition-[height] duration-300" id="header-inner">
    <a href="#inicio" class="flex items-center gap-2">
      <span class="font-display text-2xl tracking-wide text-white">INTERMEDIOS</span>
      <span class="font-display text-2xl tracking-wide text-brand-red">GRÁFICA</span>
    </a>

    <nav class="hidden md:flex items-center gap-9">
      {links.map((link) => (
        <a href={link.href} class="nav-link">
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href="https://wa.me/5493512288814"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary hidden md:inline-flex !px-5 !py-2.5 text-sm"
    >
      Cotizar ahora
    </a>

    <button
      id="menu-toggle"
      class="md:hidden text-white w-10 h-10 flex flex-col items-center justify-center gap-[5px]"
      aria-label="Abrir menú"
    >
      <span id="bar1" class="block w-5 h-px bg-white transition-transform duration-300"></span>
      <span id="bar2" class="block w-5 h-px bg-white transition-opacity duration-300"></span>
      <span id="bar3" class="block w-5 h-px bg-white transition-transform duration-300"></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden max-h-0 overflow-hidden bg-ink/98 backdrop-blur border-t border-line transition-[max-height] duration-500 ease-in-out"
  >
    <nav class="flex flex-col px-6 py-6 gap-1">
      {links.map((link) => (
        <a
          href={link.href}
          class="mobile-link font-mono text-base text-smoke hover:text-white transition-colors duration-300 py-3 border-b border-line-soft"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://wa.me/5493512288814"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary justify-center mt-5"
      >
        Cotizar por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const headerInner = document.getElementById("header-inner");

  const onScroll = () => {
    if (!header || !headerInner) return;
    if (window.scrollY > 40) {
      header.classList.add("bg-ink/85", "backdrop-blur", "border-line");
      headerInner.classList.add("h-16");
      headerInner.classList.remove("h-20");
    } else {
      header.classList.remove("bg-ink/85", "backdrop-blur", "border-line");
      headerInner.classList.remove("h-16");
      headerInner.classList.add("h-20");
    }
  };
  window.addEventListener("scroll", onScroll);
  onScroll();

  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const bar1 = document.getElementById("bar1");
  const bar2 = document.getElementById("bar2");
  const bar3 = document.getElementById("bar3");
  let open = false;

  const setMenu = (state: boolean) => {
    open = state;
    if (!menu) return;
    menu.style.maxHeight = open ? menu.scrollHeight + "px" : "0px";
    bar1?.classList.toggle("rotate-45", open);
    bar1?.classList.toggle("translate-y-[6px]", open);
    bar2?.classList.toggle("opacity-0", open);
    bar3?.classList.toggle("-rotate-45", open);
    bar3?.classList.toggle("-translate-y-[6px]", open);
  };

  toggle?.addEventListener("click", () => setMenu(!open));
  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });
</script>