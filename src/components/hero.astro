---
const tags = [
  "DISEÑO GRÁFICO",
  "IMPRESIONES",
  "LETRAS EN CHAPA",
  "LONAS Y VINILOS",
  "CARTELES ILUMINADOS",
  "ESTAMPADO DTF",
  "SUBLIMACIÓN",
  "INDUMENTARIA",
];
---

<section id="inicio" class="relative min-h-screen flex items-center pt-28 pb-20 overflow-hidden">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-24 right-[-8%] w-[280px] h-[280px] sm:w-[400px] sm:h-[400px] lg:w-[520px] lg:h-[520px] bg-brand-red/[0.07] rounded-full blur-[150px]"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-10 w-full grid lg:grid-cols-12 gap-8 sm:gap-12 items-center">
    <div class="lg:col-span-7">
      <p class="eyebrow mb-6" data-reveal>Gráfica · Cartelería · Indumentaria</p>

      <h1 class="font-display leading-[0.9] text-white" data-reveal style="font-size: clamp(2.75rem, 8vw, 6.5rem);">
        <span class="block">TODO EN UN</span>
        <span class="block text-brand-red">SOLO LUGAR</span>
      </h1>

      <p class="mt-8 max-w-lg text-smoke text-base md:text-lg leading-relaxed" data-reveal style="transition-delay:100ms">
        Gráfica, cartelería e indumentaria en un solo lugar: diseñamos, imprimimos y
        fabricamos todo lo que tu marca necesita para verse bien, con más de 10 años
        de trayectoria en el rubro.
      </p>

      <div class="mt-10 flex flex-wrap gap-4" data-reveal style="transition-delay:180ms">
        <a href="#servicios" class="btn-primary">Nuestros servicios</a>
        <a href="https://wa.me/5492634476887" target="_blank" rel="noopener noreferrer" class="btn-outline">
          Hablemos por WhatsApp
        </a>
      </div>
    </div>

    <!-- ficha técnica: mismo contenido que antes, en formato de planilla -->
    <div class="lg:col-span-4 lg:col-start-9" data-reveal="right" style="transition-delay:220ms">
      <div class="relative border border-line bg-surface/60 p-7">
        <p class="eyebrow mb-6">Ficha técnica</p>
        <ul class="space-y-3">
          {tags.map((tag, i) => (
            <li class="flex items-baseline gap-3 font-mono text-xs text-smoke border-b border-dashed border-line-soft pb-3 last:border-0 last:pb-0">
              <span class="text-brand-red">{String(i + 1).padStart(2, "0")}</span>
              {tag}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>