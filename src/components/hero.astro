---
const tags = [
  "DISEÑO GRÁFICO",
  "IMPRESIONES",
  "LETRAS EN CHAPA",
  "LONAS Y VINILOS",
  "CARTELES ILUMINADOS",
  "ESTAMPADO DTF",
  "SUBLIMACIÓN",
  "INDUMENTARIA",
];
---

<section id="inicio" class="relative min-h-screen flex flex-col justify-center pt-28 pb-16 overflow-hidden">
  <!-- fondo: una sola mancha de luz, muy sutil -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-32 right-[-10%] w-[620px] h-[620px] bg-brand-red/[0.08] rounded-full blur-[160px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-10 w-full">
    <p class="eyebrow mb-6" data-reveal>Gráfica · Cartelería · Indumentaria</p>

    <h1 class="font-display leading-[0.92] text-white" data-reveal style="font-size: clamp(2.75rem, 9vw, 7rem);">
      <span class="block">TODO EN UN</span>
      <span class="block text-brand-red">SOLO LUGAR</span>
    </h1>

    <p class="mt-8 max-w-xl text-smoke text-base md:text-lg leading-relaxed" data-reveal style="transition-delay:100ms">
      Gráfica, cartelería e indumentaria en un solo lugar: diseñamos, imprimimos y
      fabricamos todo lo que tu marca necesita para verse bien, con más de 10 años
      de trayectoria en el rubro.
    </p>

    <div class="mt-10 flex flex-wrap gap-4" data-reveal style="transition-delay:180ms">
      <a href="#servicios" class="btn-primary">Nuestros servicios</a>
      <a href="https://wa.me/5493512288814" target="_blank" rel="noopener noreferrer" class="btn-outline">
        Hablemos por WhatsApp
      </a>
    </div>
  </div>

  <!-- franja de servicios: fina, lenta, con desvanecido en los bordes -->
  <div
    class="relative mt-20 border-y border-line py-4 overflow-hidden"
    data-reveal
    style="transition-delay:260ms; -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent); mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);"
  >
    <div class="flex w-max animate-marquee">
      {[...tags, ...tags].map((tag) => (
        <span class="flex items-center font-mono text-xs md:text-sm tracking-[0.2em] text-smoke px-8 whitespace-nowrap">
          {tag}
          <span class="text-brand-red ml-8">/</span>
        </span>
      ))}
    </div>
  </div>
</section>