---
const tags = [
  "DISEÑO GRÁFICO",
  "IMPRESIONES",
  "LETRAS EN CHAPA",
  "LONAS Y VINILOS",
  "CARTELES ILUMINADOS",
  "ESTAMPADO DTF",
  "SUBLIMACIÓN",
  "INDUMENTARIA",
];
---

<section id="inicio" class="relative min-h-screen flex flex-col justify-center pt-28 pb-16 overflow-hidden">
  <!-- fondo -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-40 -right-40 w-[560px] h-[560px] bg-brand-red/20 rounded-full blur-[140px]"></div>
    <div class="absolute bottom-0 -left-40 w-[420px] h-[420px] bg-brand-red/10 rounded-full blur-[120px]"></div>
    <div
      class="absolute inset-0 opacity-[0.035]"
      style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 48px 48px;"
    >
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-10 w-full">
    <p class="font-mono text-brand-red text-sm tracking-[0.3em] mb-6" data-reveal>
      GRAFICA, CARTELERIA Y INDUMENTARIA  <span class="animate-blink">_</span>
    </p>

    <h1 class="font-display leading-[0.9] text-white" data-reveal>
      <span class="block text-[15vw] md:text-[8vw] lg:text-[7rem]">TODO EN UN</span>
      <span class="block text-[15vw] md:text-[8vw] lg:text-[7rem] text-transparent [-webkit-text-stroke:2px_#e11d2e] md:[-webkit-text-stroke:3px_#e11d2e]">
        SOLO LUGAR
      </span>
    </h1>

    <p class="mt-8 max-w-xl text-smoke text-base md:text-lg leading-relaxed" data-reveal style="transition-delay:120ms">
      Gráfica, cartelería e indumentaria en un solo lugar: diseñamos, imprimimos y
      fabricamos todo lo que tu marca necesita para verse bien, con más de 10 años
      de trayectoria en el rubro.
    </p>

    <div class="mt-10 flex flex-wrap gap-4" data-reveal style="transition-delay:220ms">
      <a
        href="#servicios"
        class="bg-brand-red hover:bg-brand-redLight text-white font-semibold px-7 py-4 transition-all duration-300 hover:-translate-y-0.5"
      >
        Nuestros servicios
      </a>
      <a
        href="https://wa.me/5493512288814"
        target="_blank"
        rel="noopener noreferrer"
        class="border border-line hover:border-brand-red text-white font-semibold px-7 py-4 transition-all duration-300 hover:-translate-y-0.5"
      >
        Hablemos por WhatsApp
      </a>
    </div>
  </div>

  <!-- marquee de servicios -->
  <div class="relative mt-20 border-y border-line py-4 overflow-hidden" data-reveal style="transition-delay:280ms">
    <div class="flex w-max animate-marquee">
      {[...tags, ...tags].map((tag, i) => (
        <span class="flex items-center font-display text-2xl md:text-3xl text-white/80 px-8 whitespace-nowrap">
          {tag}
          <span class="text-brand-red ml-8">/</span>
        </span>
      ))}
    </div>
  </div>
</section>