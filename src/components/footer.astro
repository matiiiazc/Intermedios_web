---
const year = new Date().getFullYear();
---

<footer
  class="relative py-14"
  style="border-top: 1px dashed var(--color-line);"
>
  <div class="max-w-6xl mx-auto px-6 lg:px-10">
    <div class="grid md:grid-cols-3 gap-10 mb-12">
      <div>
        <span class="font-display text-2xl text-white">INTERMEDIOS </span>
        <span class="font-display text-2xl text-brand-red">GRÁFICA</span>
        <p class="text-smoke text-sm mt-4 max-w-xs leading-relaxed">
          Cartelería, impresión y Grafica. Más de 10 años haciendo
          visibles las marcas.
        </p>
      </div>

      <div>
        <p class="eyebrow mb-4">Contacto</p>
        <a href="https://wa.me/5493512288814" class="block text-white/90 hover:text-brand-red transition-colors duration-300 mb-2">
          351 228-8814
        </a>
        <a href="mailto:contacto@zipgrafica.com.ar" class="block text-white/90 hover:text-brand-red transition-colors duration-300">
          contacto@prueba.com.ar
        </a>
      </div>

      <div>
        <p class="eyebrow mb-4">Seguinos</p>
        <div class="flex gap-5">
          <a
            href="https://www.facebook.com/graficazip/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/90 hover:text-brand-red transition-colors duration-300"
          >
            Facebook
          </a>
          <a
            href="https://www.instagram.com/zip.graphic/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/90 hover:text-brand-red transition-colors duration-300"
          >
            Instagram
          </a>
        </div>
      </div>
    </div>

    <div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4" style="border-top: 1px solid var(--color-line);">
      <p class="text-smoke-dim text-xs">© {year} Intermedios grafica — Todos los derechos reservados.</p>
    </div>
  </div>
</footer>