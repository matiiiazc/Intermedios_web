---
const categories = [
  {
    num: "01",
    title: "Gráfica",
    tagline: "Diseño e impresión",
    desc: "Todo lo que tu marca necesita en papel: identidad, tarjetería y material de difusión.",
    items: ["Diseño gráfico", "Impresiones", "Tarjetas personales", "Volantes", "Cartas comerciales"],
  },
  {
    num: "02",
    title: "Cartelería",
    tagline: "Fabricación e instalación",
    desc: "Carteles y letras fabricados a medida, en los materiales que mejor representen tu negocio.",
    items: [
      "Letras en chapa",
      "Polifán",
      "Telgopor",
      "Acrílico",
      "MDF",
      "Lonas",
      "Vinilos",
      "Carteles iluminados",
      "Retroiluminados",
    ],
  },
  {
    num: "03",
    title: "Indumentaria",
    tagline: "Estampado y sublimación",
    desc: "Personalización de prendas propias o de catálogo, lista para uso o reventa.",
    items: ["Estampado DTF", "Sublimación", "Venta de prendas", "Impresión personalizada DTF"],
  },
];
---

<section id="servicios" class="relative py-24 md:py-32 border-t border-line">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-14" data-reveal>
      <div>
        <p class="eyebrow mb-4">Servicios</p>
        <h2 class="font-display text-4xl md:text-6xl text-white leading-[0.95]">LO QUE HACEMOS</h2>
      </div>
      <p class="max-w-sm text-smoke text-sm md:text-base">
        Tres áreas, un mismo estándar de calidad: gráfica, cartelería e indumentaria.
      </p>
    </div>

    <div class="divide-y divide-dashed divide-line">
      {categories.map((c, i) => (
        <div
          class="py-10 md:py-12 grid md:grid-cols-12 gap-6 md:gap-10 items-start"
          data-reveal
          style={`transition-delay:${i * 90}ms`}
        >
          <div class="md:col-span-4 flex items-baseline gap-4">
            <span class="font-mono text-smoke-dim text-sm shrink-0">{c.num}</span>
            <div>
              <h3 class="font-display text-3xl md:text-[2.4rem] leading-none text-white">{c.title}</h3>
              <p class="eyebrow mt-3">{c.tagline}</p>
            </div>
          </div>

          <div class="md:col-span-8">
            <p class="text-smoke text-sm leading-relaxed max-w-md mb-6">{c.desc}</p>
            <ul class="flex flex-wrap gap-x-4 sm:gap-x-7 gap-y-2.5">
              {c.items.map((item) => (
                <li class="flex items-center gap-2 font-mono text-xs text-smoke">
                  <span class="text-brand-red">/</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>